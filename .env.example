# --- Google Sheets (base de datos) ---
# Email de la cuenta de servicio de Google Cloud (termina en .iam.gserviceaccount.com)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Clave privada de la cuenta de servicio (pegar tal cual, con los \n de los saltos de linea)
GOOGLE_PRIVATE_KEY=
# ID de la planilla de Google Sheets (esta en la URL: /d/ESTE_ID/edit)
GOOGLE_SHEET_ID=

# --- Admin ---
# Contrasena para entrar al panel de administracion del negocio
ADMIN_PASSWORD=
# Cadena aleatoria larga usada para firmar la sesion del admin (generar una distinta por cliente)
SESSION_SECRET=

# --- Negocio ---
# Zona horaria IANA usada para calcular turnos disponibles
TIMEZONE=America/Argentina/Buenos_Aires
